# OPAC 2026 — environment variables
# Every value here is read server-side only (inside app/api/** route handlers).
# Nothing in this file is exposed to the browser bundle.

# --- Required for their respective sources (source is skipped if unset) ---

# Unpaywall requires a real, monitored contact address per its terms of use.
# Do NOT ship a placeholder — the previous system's admin@valace.local default
# was flagged in ERESOURCES_AUDIT.md.
UNPAYWALL_EMAIL=

# DPLA requires a free API key: https://pro.dp.la/developers/api-codex
DPLA_API_KEY=

# Google Books. The keyless quota is shared across every anonymous caller
# worldwide and is effectively always exhausted, so a key is required in practice.
GOOGLE_BOOKS_API_KEY=

# --- Optional (source still works without these, just with lower rate limits) ---

# OpenAlex "polite pool" — a contact address gets you faster, more reliable service.
OPENALEX_MAILTO=

# NCBI E-utilities (PubMed Central) — raises rate limit from 3/sec to 10/sec.
NCBI_API_KEY=
